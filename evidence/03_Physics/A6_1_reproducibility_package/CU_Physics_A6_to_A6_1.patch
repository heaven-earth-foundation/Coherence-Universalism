+
+\[
+a=\frac{q}{mq+4-m},
+\qquad
+b=\frac{1}{mq+4-m},
+\]
+
+so
+
+\[
+r_m(q)
+=
+\frac{2(q-1)}{(mq+4-m)\log q}.
+\]
+
